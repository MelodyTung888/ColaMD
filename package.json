{
  "name": "colamd-melody",
  "version": "1.9.0",
  "description": "ColaMD Melody — a macOS Markdown editor for humans and AI agents",
  "main": "dist/main/index.js",
  "author": "MelodyTung888 and ColaMD contributors",
  "license": "MIT",
  "homepage": "https://github.com/MelodyTung888/ColaMD#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MelodyTung888/ColaMD.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
    "check": "npm run typecheck && npm run build",
    "preview": "electron-vite preview",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run check && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@milkdown/kit": "^7.19.2",
    "@milkdown/plugin-math": "^7.5.9",
    "electron-updater": "^6.8.9",
    "katex": "^0.16.47",
    "remark-breaks": "^4.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
